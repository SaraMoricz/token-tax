# Optional: adds the Claude column (Anthropic's count_tokens endpoint is free, rate-limited).
# Copy to .env, fill in, then: set -a; . ./.env; set +a; bash scripts/run_all.sh
ANTHROPIC_API_KEY=
# Optional: Gemini columns via the Gemini API's free countTokens endpoint (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
