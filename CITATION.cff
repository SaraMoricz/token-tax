cff-version: 1.2.0
message: "If you use this data, please cite it as below."
type: dataset
title: "Token tax: LLM token premiums for 200 languages relative to English (FLORES-200)"
abstract: >-
  Token premiums for the 200 languages of FLORES-200 (204 rows: a few languages in two scripts) on the tokenizers behind ChatGPT, Gemini, Claude, Meta's Llama,
  DeepSeek, Qwen and Mistral: tokens(language) / tokens(English) on the FLORES-200 devtest
  sentences, following Petrov et al. (2023).
authors:
  - family-names: Moricz
    given-names: Sara
    orcid: "https://orcid.org/0009-0002-0309-0120"
repository-code: "https://github.com/SaraMoricz/token-tax"
url: "https://sara.moricz.se/token-tax/"
license:
  - CC-BY-SA-4.0
  - MIT
keywords:
  - token premium
  - tokenization premium
  - token tax
  - tokenizer
  - tokenization
  - tokenizer fairness
  - large language models
  - multilingual
  - language equity
  - FLORES-200
references:
  - type: conference-paper
    title: "Language Model Tokenizers Introduce Unfairness Between Languages"
    authors:
      - family-names: Petrov
        given-names: Aleksandar
      - family-names: La Malfa
        given-names: Emanuele
      - family-names: Torr
        given-names: Philip H. S.
      - family-names: Bibi
        given-names: Adel
    collection-title: "Advances in Neural Information Processing Systems (NeurIPS 2023)"
    year: 2023
    url: "https://arxiv.org/abs/2305.15425"
  - type: data
    title: "FLORES-200"
    authors:
